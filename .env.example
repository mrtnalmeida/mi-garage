# Cliente (Vite): van en .env.local para probar y en Vercel > Settings > Environment Variables.
# Salen de Supabase > Project Settings > API.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Servidor: solo en Vercel, nunca en el repo ni con prefijo VITE_. La usa api/copiloto.js.
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: solo estos emails pueden usar el Copiloto (separados por coma).
ALLOWED_EMAILS=
